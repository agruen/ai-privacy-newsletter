# Automatic HTTPS reverse proxy (optional; used with the `tls` compose profile).
# Set DOMAIN in your environment to a real hostname for Let's Encrypt certs.
{$DOMAIN} {
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
