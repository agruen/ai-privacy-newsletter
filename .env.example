# Copy to .env and fill in. All variables are prefixed APN_.

# Core
APN_ENVIRONMENT=production
# REQUIRED in production: a strong random value (>=32 chars). The app refuses to
# boot in production without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APN_SECRET_KEY=

# Admin account, created on first boot. REQUIRED on first run — without a
# password no admin is created and you cannot log in.
APN_ADMIN_USERNAME=admin
APN_ADMIN_PASSWORD=

# Storage (inside the container; mapped to the digest_data volume)
APN_DATA_DIR=/data

# Scheduler. Off by default: run ingest and generation on demand from the web UI
# (Sources -> "Run ingest now", Newsletters -> "Generate"). Set to true to also
# run the cron jobs below automatically.
APN_SCHEDULER_ENABLED=false
APN_DAILY_INGEST_CRON=0 7 * * *
APN_MONTHLY_SYNTH_CRON=0 8 1 * *

# LLM — monthly synthesis + the email channel below
APN_ANTHROPIC_API_KEY=
APN_ANTHROPIC_MONTHLY_BUDGET_USD=100

# Email channel. When the IMAP settings are filled in, the app polls the intake
# mailbox every 5 minutes for submitted incidents and checks the AI Incident
# Database daily at noon Washington DC time, emailing write-ups to the digest
# recipient. Works with any IMAP/SMTP mailbox (for Gmail: an app password).
# Leave APN_IMAP_HOST empty to keep the whole channel off.
APN_EMAIL_ENABLED=true
APN_IMAP_HOST=
APN_IMAP_PORT=993
APN_IMAP_USERNAME=
APN_IMAP_PASSWORD=
APN_IMAP_FOLDER=INBOX
# SMTP defaults are derived from the IMAP settings (imap.x -> smtp.x, same
# credentials); override only if your provider differs.
APN_SMTP_HOST=
APN_SMTP_PORT=465
APN_SMTP_USERNAME=
APN_SMTP_PASSWORD=
APN_MAIL_FROM=
# Who receives the write-ups (also editable on the Settings page).
APN_DIGEST_TO=
# Schedules and guardrails (defaults shown).
APN_EMAIL_POLL_MINUTES=5
APN_AIID_CHECK_CRON=0 12 * * *
APN_AIID_CHECK_TZ=America/New_York
APN_EMAIL_MAX_PER_POLL=10
APN_AIID_DIGEST_MAX=15
APN_WEB_SEARCH_MAX_USES=5

# Reverse proxy (only needed with the `tls` compose profile)
DOMAIN=localhost
